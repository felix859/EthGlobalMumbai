# Copy to .env and fill in. NEVER commit .env. Testnet keys only.

# --- Hedera ---
HEDERA_NETWORK=hedera:testnet
# Account that PAYS (the agent's wallet)
AGENT_ACCOUNT_ID=0.0.xxxxx
AGENT_PRIVATE_KEY=
# Account that RECEIVES (the merchant / server)
MERCHANT_ACCOUNT_ID=0.0.xxxxx
# More trusted sellers (e.g. the Analyst agent) can be added comma-separated: 0.0.111,0.0.222
# and their origins in TRUSTED_ORIGINS (comma-separated). The agent pays only these.
TRUSTED_ORIGINS=
# HCS audit topic (created by scripts/create-topic.ts)
HCS_TOPIC_ID=0.0.xxxxx

# HTS receipt NFT collection (npm run setup:receipt). Leave empty to disable receipts.
RECEIPT_TOKEN_ID=

# Agent identity (npm run setup:identity). Optional.
IDENTITY_TOPIC_ID=
AGENT_UAID=

# --- x402 ---
# Blocky402 testnet; alternatives: https://x402.org/facilitator , https://testnet.facilitator.launa.dev
FACILITATOR_URL=https://api.testnet.blocky402.com
# "0.0.0" = native HBAR (amounts in tinybars). Switch to an HTS token id if the spike requires it.
PAYMENT_ASSET=0.0.0
# Required only for an HTS token (HBAR is always 8)
PAYMENT_ASSET_DECIMALS=
# Data server prices, in the asset's smallest unit (defaults: 1M, 2M, 3M, 5M tinybars)
PRICE_WEATHER_TINYBARS=
PRICE_AIR_QUALITY_TINYBARS=
PRICE_HBAR_PRICE_TINYBARS=
PRICE_HEADLINES_TINYBARS=

# --- Agent ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Hard spending limits, in tinybars (1 HBAR = 100,000,000)
# Per run and across all runs since the agent started (defaults: 2 HBAR and 10 HBAR)
MAX_RUN_BUDGET_TINYBARS=200000000
MAX_TOTAL_SPEND_TINYBARS=1000000000
# Purchases above this pause for human approval (empty/0 = fully autonomous)
APPROVAL_ABOVE_TINYBARS=
APPROVAL_TIMEOUT_MS=30000
MAX_PRICE_PER_CALL=10000000
DEFAULT_RUN_BUDGET=50000000

# --- Analyst agent (seller + buyer; npm run setup:analyst, npm run dev:analyst) ---
ANALYST_ACCOUNT_ID=
ANALYST_PRIVATE_KEY=
ANALYST_PORT=3100
# Where the analyst buys its data, and what it sells
UPSTREAM_PATHS=/api/weather,/api/hbar-price
BRIEFING_PRICE_TINYBARS=3000000
# For the buying agent: also read the analyst's catalogue (and trust it, see MERCHANT_ACCOUNT_ID / TRUSTED_ORIGINS above)
EXTRA_CATALOGUE_URLS=

# --- Ports / URLs ---
SERVER_PORT=3000
AGENT_PORT=4000
SERVER_URL=http://localhost:3000
AGENT_URL=http://localhost:4000
