# Copy to .env and fill in. NEVER commit .env. Testnet keys only.
# Amounts are in tinybars: 1 HBAR = 100,000,000. All spending limits below are enforced in code, in memory:
# restarting a process resets its "total" counters.

# --- Hedera ---
# Account that PAYS (the agent's wallet). Use a dedicated low-balance testnet account.
AGENT_ACCOUNT_ID=0.0.xxxxx
AGENT_PRIVATE_KEY=
# The data server's own payee: ONE account id. Buyers trust it by default; they never take a payee from a catalogue.
MERCHANT_ACCOUNT_ID=0.0.xxxxx
# Optional, for BUYERS (agent, MCP): every account they may pay, comma-separated, e.g. the merchant plus the
# Analyst agent: 0.0.111,0.0.222. Empty = only MERCHANT_ACCOUNT_ID.
TRUSTED_PAYEES=
# Written by `npm run setup:hedera` together with MERCHANT_ACCOUNT_ID (needed only to run the data server).
MERCHANT_PRIVATE_KEY=
# Origins the agent may pay besides SERVER_URL, comma-separated (e.g. http://localhost:3100 for the Analyst)
TRUSTED_ORIGINS=
# HCS audit topic (created by `npm run setup:hedera`)
HCS_TOPIC_ID=0.0.xxxxx

# HTS receipt NFT collection (`npm run setup:receipt`). Leave empty to disable receipts.
RECEIPT_TOKEN_ID=

# Agent identity (`npm run setup:identity`). Optional.
IDENTITY_TOPIC_ID=
AGENT_UAID=

# --- x402 ---
# Blocky402 testnet; alternatives: https://x402.org/facilitator , https://testnet.facilitator.launa.dev
FACILITATOR_URL=https://api.testnet.blocky402.com
# "0.0.0" = native HBAR (amounts in tinybars)
PAYMENT_ASSET=0.0.0
# Required only for an HTS token (HBAR is always 8)
PAYMENT_ASSET_DECIMALS=
# Data server prices, in the asset's smallest unit (defaults: 1M, 2M, 3M, 5M tinybars)
PRICE_WEATHER_TINYBARS=
PRICE_AIR_QUALITY_TINYBARS=
PRICE_HBAR_PRICE_TINYBARS=
PRICE_HEADLINES_TINYBARS=

# --- Agent ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Per-run ceiling (2 HBAR) and process-wide ceiling across all runs (10 HBAR)
MAX_RUN_BUDGET_TINYBARS=200000000
MAX_TOTAL_SPEND_TINYBARS=1000000000
# Max for one purchase (0.1 HBAR). An API caller can only LOWER this, never raise it.
MAX_PRICE_PER_CALL=10000000
# Purchases above this pause for human approval (empty/0 = fully autonomous). A caller can only lower it.
APPROVAL_ABOVE_TINYBARS=
APPROVAL_TIMEOUT_MS=30000
# Default budget the API (#4) uses when a request does not send one
DEFAULT_RUN_BUDGET=50000000
# Where successful runs are recorded for replay (gitignored)
RECORD_DIR=runs
# Other sellers' catalogues to read, comma-separated (e.g. http://localhost:3100/catalogue). They must also be in
# TRUSTED_PAYEES and TRUSTED_ORIGINS, or the agent skips them.
EXTRA_CATALOGUE_URLS=

# --- MCP server (packages/mcp) ---
# Total the MCP session may spend (0.2 HBAR). Cannot exceed MAX_RUN_BUDGET_TINYBARS.
MCP_SESSION_BUDGET_TINYBARS=20000000

# --- Analyst agent (seller + buyer; `npm run setup:analyst`, `npm run dev:analyst`) ---
ANALYST_ACCOUNT_ID=
ANALYST_PRIVATE_KEY=
ANALYST_PORT=3100
# Where the analyst buys its data, and which paths. Their total price must fit BRIEFING_COST_CAP_TINYBARS
# (checked at startup): weather alone costs 0.01 HBAR on the default data server.
UPSTREAM_URL=http://localhost:3000
UPSTREAM_PATHS=/api/weather
# Sale price, and max upstream cost per briefing (must be BELOW the price; default 2/3 of it)
BRIEFING_PRICE_TINYBARS=3000000
BRIEFING_COST_CAP_TINYBARS=2000000
# Total the analyst wallet may spend upstream (0.5 HBAR), concurrent briefings, briefings per minute
ANALYST_MAX_TOTAL_SPEND_TINYBARS=50000000
BRIEFING_MAX_CONCURRENT=2
BRIEFING_MAX_PER_MINUTE=10

# --- Web dashboard (packages/web; read at build/dev time by Vite) ---
VITE_AGENT_URL=http://localhost:4000

# --- Ports / URLs ---
SERVER_PORT=3000
AGENT_PORT=4000
# The agent API has no auth and spends real HBAR: it listens on 127.0.0.1 unless you set this (e.g. 0.0.0.0 to deploy)
AGENT_HOST=
# Origin allowed by the agent API's CORS (the web app)
WEB_ORIGIN=http://localhost:5173
# Live or replayed runs allowed at once
MAX_ACTIVE_RUNS=3
SERVER_URL=http://localhost:3000
# Shown in the agent's published identity profile
AGENT_URL=http://localhost:4000
